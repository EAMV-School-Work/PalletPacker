@model PalletDefinitionFormViewModel

@{
    ViewData["Title"] = "Tilføj palledefinition";
}

<h1>Tilføj palledefinition</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Navn</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PalletType" class="form-label">Palletype</label>
        <input asp-for="PalletType" class="form-control" />
        <span asp-validation-for="PalletType" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="LengthMm" class="form-label">Længde (mm)</label>
            <input asp-for="LengthMm" type="number" min="1" class="form-control" />
            <span asp-validation-for="LengthMm" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="WidthMm" class="form-label">Bredde (mm)</label>
            <input asp-for="WidthMm" type="number" min="1" class="form-control" />
            <span asp-validation-for="WidthMm" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="HeightMm" class="form-label">Højde (mm)</label>
            <input asp-for="HeightMm" type="number" min="1" class="form-control" />
            <span asp-validation-for="HeightMm" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="OwnWeightKg" class="form-label">Egenvægt (kg)</label>
            <input asp-for="OwnWeightKg" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="OwnWeightKg" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="MaxWeightKg" class="form-label">Maks. vægt (kg)</label>
            <input asp-for="MaxWeightKg" type="number" min="0.01" step="0.01" class="form-control" />
            <span asp-validation-for="MaxWeightKg" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="MaxHeightMm" class="form-label">Maks. højde (mm)</label>
            <input asp-for="MaxHeightMm" type="number" min="1" class="form-control" />
            <span asp-validation-for="MaxHeightMm" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="AllowedOverhangMm" class="form-label">
            Tilladt overmål (mm)
        </label>
        <input asp-for="AllowedOverhangMm" type="number" min="0" class="form-control" />
        <span asp-validation-for="AllowedOverhangMm" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">
            Aktiv (må bruges til optimering)
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Gem</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Annuller</a>
</form>